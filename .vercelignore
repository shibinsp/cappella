# Dev/test harness — not part of the served site
tests/
scripts/
playwright.config.js
playwright-report/
test-artifacts/
test-results/
screenshots/
node_modules/
uploads/

# AI-tooling working dirs — never repo content, must not reach production.
# The working-tree deploy would otherwise publish local editor config and
# QA session logs (settings.local.json, browse-*.log).
.claude/
.gstack/

# Vercel CLI state. Holds .env.preview.local, which carries a live
# VERCEL_OIDC_TOKEN. The CLI already excludes this by default — listed
# explicitly because deploys here upload the WORKING TREE, and a credential
# is not something to leave resting on a default.
.vercel/

# Design drafts. Deploys here upload the WORKING TREE, not git, so an
# untracked scratch folder still ships — without this, /mockups/*.html is
# publicly reachable on the client-facing site. Caught on the 2026-07-22
# deploy, where the folder had to be moved aside by hand to keep drafts off
# production.
mockups/

# Source material / docs — not for public hosting
Scroll animation request/
*.docx
*.pdf
rules.md
README.md
